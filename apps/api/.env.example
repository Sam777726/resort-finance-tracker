NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml's postgres service by default)
DATABASE_URL=postgresql://campdilly:campdilly@localhost:5432/campdilly?schema=public

# Redis (cache-aside for reports/settings, refresh-token store, rate limiting, BullMQ queue)
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank only if you're running a bare `redis-server` locally with no
# --requirepass. If these two services came from `docker compose up
# postgres redis` (see README "Option B"), they now require a password —
# match whatever REDIS_PASSWORD is set to in the root .env.
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL_SECONDS=604800

# CORS — the Vite dev server / built web app origin
WEB_ORIGIN=http://localhost:5173
