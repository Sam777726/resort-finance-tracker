# Copy this file to `.env` in the same directory (repo root) and fill in
# real values. `docker compose` reads `.env` automatically — this is a
# SEPARATE mechanism from apps/api/.env.example, which is only for running
# the API directly on your machine without Docker (see README).
#
# This file (.env.example) is safe to commit — it has no real secrets.
# The `.env` file you create from it must NEVER be committed (.gitignore
# already excludes it).

# --- Postgres ---
POSTGRES_USER=campdilly
POSTGRES_PASSWORD=change-me-generate-a-real-random-value
POSTGRES_DB=campdilly

# --- Redis ---
# Redis has no authentication by default — this is required, not optional.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change-me-generate-a-real-random-value

# --- JWT signing secrets ---
# Generate each with, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use TWO DIFFERENT values — access and refresh must not share a secret.
JWT_ACCESS_SECRET=change-me-generate-a-real-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-generate-a-different-random-value
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS ---
# The origin the web app is actually served from. Update this once you
# have a real domain — see the deployment steps in README.md.
WEB_ORIGIN=http://localhost:8080
